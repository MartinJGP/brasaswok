# Plantilla de Variables de Entorno para Brasas & Wok
# Duplica este archivo como .env para desarrollo local o copia estos valores en tu panel de despliegue (Render, Railway, etc.)

# Base de datos MySQL
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/brasas_wok_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# Puerto del backend
PORT=8080

# Llave secreta para generación y validación de tokens JWT
APP_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
APP_JWT_EXPIRATION_MS=86400000

# Orígenes permitidos para peticiones CORS (separados por comas)
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:80,http://localhost,https://*.vercel.app
